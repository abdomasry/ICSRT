# Email Configuration for User Verification
# Configure these environment variables for email verification to work

# Gmail Configuration (recommended)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# For Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an "App Password" for this application
# 3. Use the app password (not your regular password) in EMAIL_PASS

# Alternative Email Providers:
# You can also use Yahoo, Outlook, or custom SMTP servers
# Update the service in server.js createEmailTransporter() function

# Example for custom SMTP:
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=your-email@domain.com
# EMAIL_PASS=your-password

# Application Settings
NODE_ENV=development
PORT=3000

# Database (already configured in server.js)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Paymob (Test/Sandbox) Configuration
# Obtain these from Paymob Dashboard (Developers > API Keys, Integrations, Iframes)
PAYMOB_API_KEY=pk_test_your_paymob_api_key
PAYMOB_INTEGRATION_ID=0000000
PAYMOB_IFRAME_ID=000000
PAYMOB_HMAC_SECRET=hmac_test_secret

# Frontend URL used in some emails/links (optional)
# FRONTEND_URL=http://localhost:3002
